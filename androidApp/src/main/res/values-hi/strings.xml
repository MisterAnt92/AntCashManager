    <!-- Privacy Policy -->
    <string name="privacy_policy_title">गोपनीयता नीति</string>
    <string name="privacy_policy_content">AntCashManager आपकी गोपनीयता की रक्षा के लिए प्रतिबद्ध है। यह एप्लिकेशन तीसरे पक्षों के साथ व्यक्तिगत डेटा एकत्र या साझा नहीं करता है। सारा वित्तीय डेटा आपके डिवाइस पर स्थानीय रूप से संग्रहीत किया जाता है और बाहरी सर्वरों पर कभी भी प्रेषित नहीं किया जाता है।\n\nआपका डेटा पूरी तरह से आपके डिवाइस पर और आपके नियंत्रण में रहता है। हम विश्लेषण, ट्रैकिंग या विज्ञापन सेवाओं का उपयोग नहीं करते हैं।\n\nगोपनीयता के बारे में किसी भी प्रश्न के लिए, कृपया ऐप स्टोर लिस्टिंग के माध्यम से हमसे संपर्क करें।</string>

