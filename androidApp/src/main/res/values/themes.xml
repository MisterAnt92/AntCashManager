<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Main app theme (applied after splash screen is dismissed) -->
    <style name="Theme.AntCashManager" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash screen theme: shown by the OS during cold start.
         postSplashScreenTheme transitions to Theme.AntCashManager after installSplashScreen().
         windowSplashScreenBackground should match the app's light background. -->
    <style name="Theme.AntCashManager.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.AntCashManager</item>
    </style>

</resources>
