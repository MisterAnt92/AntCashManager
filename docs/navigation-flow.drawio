        <mxCell id="charts" value="ChartsScreen&#xa;route: charts&#xa;BottomBar tab 2 (se showCharts=true)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1">
