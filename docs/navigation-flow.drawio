          <mxGeometry x="860" y="80" width="210" height="80" as="geometry" />
        </mxCell>

        <!-- === SETTINGS GRAPH === -->
        <mxCell id="settings" value="SettingsScreen&#xa;route: settings&#xa;nested graph: settings_graph&#xa;Sidebar (phone) / Rail (tablet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="470" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="display" value="DisplayScreen&#xa;route: display&#xa;isSubScreen=true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="590" y="440" width="200" height="60" as="geometry" />
