          <mxGeometry x="590" y="520" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="profiles" value="ProfilesScreen&#xa;route: profiles&#xa;isSubScreen=true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="590" y="600" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- === TRANSACTION SUB-SCREENS === -->
        <mxCell id="addtx" value="AddTransactionScreen&#xa;route: add_transaction&#xa;?transactionId={id} (opt, edit)&#xa;isSubScreen=true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="860" y="195" width="210" height="90" as="geometry" />
        </mxCell>

        <mxCell id="receiptscan" value="ReceiptScanScreen&#xa;route: receipt_scan&#xa;isSubScreen=true&#xa;3 step: CAPTURE→PROCESSING→REVIEW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="860" y="350" width="210" height="90" as="geometry" />
        </mxCell>

        <!-- === NAVIGATION EDGES === -->

        <!-- Splash → Home -->
        <mxCell id="e-splash-home" value="startup guard" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" source="splash" target="home" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Home ↔ Charts -->
        <mxCell id="e-home-charts" value="BottomBar tab switch&#xa;navigateToBottomTab()" style="edgeStyle=elbowEdgeStyle;elbow=vertical;endArrow=open;startArrow=open;startFill=0;endFill=0;" edge="1" source="home" target="charts" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Home ↔ Transactions -->
        <mxCell id="e-home-transactions" value="BottomBar tab switch&#xa;navigateToBottomTab()" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;startArrow=open;startFill=0;endFill=0;" edge="1" source="home" target="transactions" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Home ↔ Categories (sidebar/rail) -->
        <mxCell id="e-home-categories" value="Sidebar / Rail&#xa;navigateToBottomTab()" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;startArrow=open;startFill=0;endFill=0;dashed=1;" edge="1" source="home" target="categories" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Home ↔ Settings (sidebar/rail) -->
        <mxCell id="e-home-settings" value="Sidebar / Rail&#xa;navigateToBottomTab()" style="edgeStyle=orthogonalEdgeStyle;endArrow=open;startArrow=open;startFill=0;endFill=0;dashed=1;" edge="1" source="home" target="settings" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Home → AddTransaction (FAB) -->
        <mxCell id="e-home-addtx" value="FAB add&#xa;navigateToAddTransaction()" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" source="home" target="addtx" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Home → TransactionDetailsDialog -->
        <mxCell id="e-home-txdetails" value="tap transaction&#xa;ShowTransactionDetailsEvent" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;dashed=1;" edge="1" source="home" target="txdetails" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Transactions → AddTransaction (FAB add) -->
        <mxCell id="e-tx-addtx-new" value="FAB add&#xa;navigateToAddTransaction()" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" source="transactions" target="addtx" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Transactions → ReceiptScan -->
        <mxCell id="e-tx-receipt" value="FAB scan&#xa;navigateToReceiptScan()" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" source="transactions" target="receiptscan" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Transactions → TransactionDetailsDialog -->
        <mxCell id="e-tx-txdetails" value="tap transaction&#xa;ShowTransactionDetailsEvent" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;dashed=1;" edge="1" source="transactions" target="txdetails" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- TransactionDetails → AddTransaction (edit) -->
        <mxCell id="e-txdetails-edit" value="tap Edit&#xa;navigateToEditTransaction(id)" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" source="txdetails" target="addtx" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- AddTransaction → ReceiptScan -->
        <mxCell id="e-addtx-receipt" value="scan receipt&#xa;navigateToReceiptScan()" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" source="addtx" target="receiptscan" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- AddTransaction back -->
        <mxCell id="e-addtx-back" value="back&#xa;safePopBackStack()" style="endArrow=open;endFill=0;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" source="addtx" target="transactions" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="830" y="240" />
              <mxPoint x="830" y="260" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Settings → Display -->
        <mxCell id="e-settings-display" value="navigateToDisplaySettings()" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" source="settings" target="display" parent="1">
