          <mxGeometry x="590" y="225" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="categories" value="CategoriesScreen&#xa;route: categories&#xa;Sidebar (phone) / Rail (tablet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="590" y="350" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- TransactionDetailsDialog (inline, non route) -->
