        <!-- Settings sub-screens back -->
        <mxCell id="e-display-back" value="back" style="endArrow=open;endFill=0;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.3;" edge="1" source="display" target="settings" parent="1">
          <mxGeometry relative="1" as="geometry" />
