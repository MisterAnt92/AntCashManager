        <mxCell id="e-data-back" value="back" style="endArrow=open;endFill=0;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" source="settingsdata" target="settings" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-profiles-back" value="back" style="endArrow=open;endFill=0;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.7;" edge="1" source="profiles" target="settings" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Tutorial overlay -->
        <mxCell id="e-tutorial-home" value="overlay su NavHost&#xa;isTutorialCompleted=false" style="endArrow=open;endFill=0;dashed=1;strokeColor=#b85450;" edge="1" source="tutorial" target="home" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- === ANNOTATION BOXES === -->

        <mxCell id="ann-navhost" value="NavHost (AntCashManagerNavHost)&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;• Guard: isTutorialCompleted==null → SplashScreen&#xa;• GDPR: completed &amp;&amp; analyticsConsent==null&#xa;  → AnalyticsConsentDialog (overlay)&#xa;• Tutorial Reveal spotlight overlay&#xa;• BackHandler priority:&#xa;  1. sidebar close&#xa;  2. show exit dialog&#xa;  3. popBackStack&#xa;• Analytics: logScreenView(route) ad ogni cambio" style="text;html=1;align=left;verticalAlign=top;strokeColor=#666666;fillColor=#f5f5f5;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1140" y="60" width="310" height="180" as="geometry" />
        </mxCell>

        <mxCell id="ann-home" value="HomeScreen Logic&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;State: totalIncome, totalExpense, netBalance,&#xa;  transactions, savingsRate/Amount/GoalRate,&#xa;  TrendBadge (delta%), SpendingForecastCard,&#xa;  mealVoucherSummary, topCardsOrder&#xa;Events: SelectDateFilter, SetDatePreset,&#xa;  NavigateToAdd, ShowTransactionDetails&#xa;UseCases: GetTransactions, FilterTransactions,&#xa;  GetPreviousPeriodData, GetCategories&#xa;Repo (direct): SettingsRepository (flow)&#xa;Foldable: split-pane con TransactionDetailsDialog" style="text;html=1;align=left;verticalAlign=top;strokeColor=#6c8ebf;fillColor=#dae8fc;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1140" y="260" width="310" height="195" as="geometry" />
        </mxCell>

        <mxCell id="ann-transactions" value="TransactionsScreen Logic&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;State: transactions, filteredTransactions,&#xa;  searchQuery, filters (cat/type/paymentType),&#xa;  pendingFilters (staged before Apply), dateFilter&#xa;Events: Search, SetFilter, ApplyFilters,&#xa;  NavigateToAdd, NavigateToEdit, NavigateToScan&#xa;Encrypted search: load-decrypt-filter in-memory&#xa;  se encryption ON&#xa;Foldable: split-pane con detail pane" style="text;html=1;align=left;verticalAlign=top;strokeColor=#6c8ebf;fillColor=#dae8fc;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1140" y="475" width="310" height="165" as="geometry" />
        </mxCell>

        <mxCell id="ann-categories" value="CategoriesScreen Logic&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;State: expenseCategories, incomeCategories,&#xa;  budgets: Map&lt;Long, CategoryBudget&gt;,&#xa;  categoryExpenseTotals, editingBudgetCategoryId&#xa;Events: AddCategory, UpdateCategory, Delete,&#xa;  SetHidden, Reorder, RestoreDefaults,&#xa;  OpenBudgetDialog, SetBudget, DeleteBudget&#xa;Tablet: grid 3 colonne&#xa;Budget: wallet chip + LinearProgressIndicator" style="text;html=1;align=left;verticalAlign=top;strokeColor=#6c8ebf;fillColor=#dae8fc;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1480" y="60" width="310" height="175" as="geometry" />
        </mxCell>

        <mxCell id="ann-charts" value="ChartsScreen Logic&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;State: chartData (by cat/month/year/weekday),&#xa;  dateRange, selectedPresetIndex,&#xa;  selectedChartDetails, chartCardsOrder,&#xa;  previousPeriod income/expense&#xa;Visible only if showCharts=true (NavSettings)&#xa;Events: SetDateRange, SetPreset, SelectCategory,&#xa;  ClearSelection, ReorderCards&#xa;SpendingForecastCard: attiva dal 3° giorno" style="text;html=1;align=left;verticalAlign=top;strokeColor=#6c8ebf;fillColor=#dae8fc;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1480" y="255" width="310" height="165" as="geometry" />
        </mxCell>

        <mxCell id="ann-settings" value="Settings Area Logic&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;SettingsScreen: theme, language, showCharts,&#xa;  tutorial replay, analytics consent&#xa;DisplayScreen (17 props): currency, format, date,&#xa;  mealVoucherValue, maskAmounts, widgetConfig,&#xa;  useDynamicColor, transactionDisplayType&#xa;SettingsDataScreen: encryption, suggestions,&#xa;  backup (local/Drive), restore, delete all, GDrive OAuth&#xa;ProfilesScreen: multi-profilo CRUD" style="text;html=1;align=left;verticalAlign=top;strokeColor=#d6b656;fillColor=#fff2cc;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1480" y="440" width="310" height="185" as="geometry" />
        </mxCell>

        <mxCell id="ann-addtx" value="AddTransactionScreen Logic&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;Mode: transactionId==null → ADD; !=null → EDIT&#xa;Step 1: category selection (auto-advance)&#xa;Step 2: amount, payee, notes, tags, date, recurring&#xa;PaymentType: auto-select MEAL_VOUCHERS per cat.&#xa;MealVoucher: auto-calc amount da count+difference&#xa;ReceiptScan: OCR pre-fills fields (back-stack)&#xa;Events: SelectCategory, UpdateField*, Submit,&#xa;  Delete (edit), ScanReceipt, NavigateBack" style="text;html=1;align=left;verticalAlign=top;strokeColor=#82b366;fillColor=#d5e8d4;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1140" y="660" width="310" height="185" as="geometry" />
        </mxCell>

        <mxCell id="ann-receiptscan" value="ReceiptScanScreen Logic&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;3 step: CAPTURE → PROCESSING → REVIEW&#xa;OCR: ML Kit on-device (ScanReceiptUseCase)&#xa;State: capturedImageUri, ocrResult,&#xa;  extracted (title, payee, amount, date, items),&#xa;  selectedCategory, selectedPaymentType&#xa;Events: ScanReceiptEvent, UpdateField*,&#xa;  SelectCategory, RetryCapture, NavigateBack&#xa;On REVIEW: popBackStack ritorna ad AddTransaction" style="text;html=1;align=left;verticalAlign=top;strokeColor=#82b366;fillColor=#d5e8d4;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1480" y="660" width="310" height="185" as="geometry" />
        </mxCell>

